ANTHROPIC_API_KEY=
# Facultatif : fuseau horaire de l'agence pour les dates (par défaut America/New_York)
CAREOPS_TZ=America/New_York
# Facultatif : jours fériés sautés par le délai de tri. Non définie = jours fériés fédéraux ;
# vide = aucun (seuls les week-ends) ; sinon des dates séparées par des virgules.
# CAREOPS_HOLIDAYS=2026-11-26,2026-12-25
